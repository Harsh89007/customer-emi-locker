<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1F3A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kings EMI Locker"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🔒"
            android:textSize="36sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DEVICE LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_lock_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="आपकी EMI बकाया है। भुगतान करने के बाद डीलर से अनलॉक करवाएँ। बिना अनुमति फोन उपयोग नहीं कर सकते।"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <!-- Offline unlock: ENTER code (codes NOT shown) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Offline Unlock Code"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center" />

        <EditText
            android:id="@+id/et_unlock_code"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="6-digit code (dealer se lein)"
            android:inputType="number"
            android:maxLength="8"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:background="#132743"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btn_submit_code"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Unlock with Code"
            android:textColor="#0B1F3A"
            android:textStyle="bold"
            android:backgroundTint="#22C55E" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Code sirf dealer panel me dikhta hai. Yahan type karke unlock karein."
            android:textColor="#64748B"
            android:textSize="11sp"
            android:gravity="center" />

        <!-- UPI QR -->
        <ImageView
            android:id="@+id/qr_code_image"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="UPI se payment scan karein"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_connect_wifi"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="CONNECT WI-FI (60 SEC)"
            android:textColor="#0B1F3A"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#38BDF8" />
    </LinearLayout>
</ScrollView>
