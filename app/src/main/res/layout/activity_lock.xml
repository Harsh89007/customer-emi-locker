<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#B71C1C"
    android:padding="20dp">

    <!-- लॉक आइकॉन -->
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_secure"
        app:tint="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="आपकी EMI का भुगतान नहीं हुआ है। कृपया जल्द से जल्द अपनी बकाया EMI जमा करें, अन्यथा यह फोन काम नहीं करेगा।"
        android:textColor="#FFCDD2"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"/>

    <!-- QR Code का डिब्बा (पेमेंट के लिए) -->
    <androidx.cardview.widget.CardView
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="पेमेंट करने के लिए स्कैन करें"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <!-- यहाँ आपका PhonePe/Paytm QR Code दिखेगा -->
            <ImageView
                android:id="@+id/img_payment_qr"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="#EEEEEE"
                android:src="@android:drawable/ic_menu_gallery" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPI Apps (PhonePe, GPay, Paytm) से स्कैन करें"
                android:textColor="#555555"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_check_status"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="मैंने पेमेंट कर दिया है (Check Status)"
        android:backgroundTint="#FFFFFF"
        android:textColor="#B71C1C"
        android:textSize="16sp"
        android:textStyle="bold"/>

</LinearLayout>
