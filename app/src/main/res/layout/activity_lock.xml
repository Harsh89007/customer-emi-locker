<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#EF4444"
    android:padding="20dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_secure"
        android:layout_marginBottom="16dp"
        android:tint="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="आपकी EMI का भुगतान नहीं हुआ है। कृपया जल्द से जल्द अपनी बकाया EMI जमा करें, अन्यथा यह फोन काम नहीं करेगा।"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="30dp"/>

    <!-- QR Code Placeholder -->
    <ImageView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_gallery" />
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="स्कैन करके पेमेंट करें"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="10dp"/>
</LinearLayout>

